{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "node_modules/(@nestjs/event-emitter|eventemitter2)/.+\\.js$": "<rootDir>/esm-to-cjs.transformer.cjs"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs/event-emitter|eventemitter2)/)"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^uuid$": "<rootDir>/uuid.cjs-shim.js"
  }
}
